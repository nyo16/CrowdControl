#!/bin/sh
# Baked into the release by `mix release` (Mix picks up rel/env.sh.eex
# automatically). It runs before the VM starts, on every `start`, `daemon`,
# `rpc` and `eval`.

# A bare cloud VM usually has no UTF-8 locale, so the VM comes up with native
# name encoding latin1 and Elixir warns that it "may cause Elixir to
# malfunction". Observed on debian:bookworm-slim with no locale configured,
# which is exactly the GCE case. +fnu forces UTF-8 filename handling regardless
# of the ambient locale, so the release behaves the same on a developer's
# machine and on a freshly-created instance.
export ELIXIR_ERL_OPTIONS="+fnu"

# Distribution is off, deliberately. Nothing needs to connect to this node: the
# only interface is the HTTP agent on a non-routable port, and an
# EPMD-registered node on a host running untrusted model-driven code would be a
# second listening port that CC_SANDBOXD_BIND does not govern.
#
# Consequence, and it is a real one: `bin/sandboxd stop`, `rpc`, `remote` and
# `eval` all need a live node and therefore DO NOT WORK. Stop the agent with
# `POST /v1/shutdown`, or SIGTERM. Destroying the sandbox is the provider's job
# either way, so nothing in CrowdControl calls those commands.
export RELEASE_DISTRIBUTION=none
